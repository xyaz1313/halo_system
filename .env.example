# Halo System environment variables.
#
# Copy to `.env` for local overrides. Docker Compose already sets
# DATABASE_URL for the `app` service, so this file is primarily
# useful for bare-metal runs and to document the full surface.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# SQLAlchemy URL. Defaults (in backend/db/engine.py) to sqlite:///halo.db,
# i.e. a `halo.db` file in the current working directory.
#
# Docker Compose overrides this to point at the named volume:
#   sqlite:////app/data/halo.db
# (four slashes = absolute path in SQLAlchemy's SQLite URL form).
#
# Postgres support is planned but not yet wired up. When it lands the
# URL will look like:
#   # DATABASE_URL=postgresql+psycopg://user:pass@host:5432/halo
DATABASE_URL=sqlite:///halo.db
